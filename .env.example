// Runtime
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string, including the database name.
# Transactions require a replica set (Atlas works; standalone local mongod does not).
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Clerk PEM public key used by @clerk/backend verifyToken (Dashboard > API Keys > PEM public key).
# Store it as a single line with \n escapes: -----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
CLERK_JWT_KEY=

# Comma-separated allowed frontend origins, no trailing slash.
CORS_ORIGIN=http://localhost:3000
