# Runtime
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string, including the database name.
# Transactions require a replica set (Atlas works; a standalone local mongod does not).
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Clerk PEM public key used by @clerk/backend verifyToken
# (Clerk Dashboard > API Keys > PEM public key).
# Paste it either as a multi-line quoted value or as one line with \n escapes —
# env.js normalises escapes and validates the RSA key at startup.
CLERK_JWT_KEY=

# Comma-separated allowed frontend origins. Each must be an exact http(s)
# origin: scheme + host + port, no path and no trailing slash.
CORS_ORIGIN=http://localhost:3000
